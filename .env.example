# Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Azure DevOps ──────────────────────────────────────────────────────────────
AZURE_DEVOPS_ORG=https://dev.azure.com/<your-org>
AZURE_DEVOPS_PROJECT=<your-project>
AZURE_DEVOPS_PAT=<your-personal-access-token>

# ── SAP BTP Global Account ────────────────────────────────────────────────────
BTP_GLOBAL_ACCOUNT_ID=<your-global-account-id>
BTP_REGION=eu10          # e.g. eu10, us10, ap10

# ── BTP Subaccounts ───────────────────────────────────────────────────────────
BTP_SUBACCOUNT_DEV=<subaccount-id-dev>
BTP_SUBACCOUNT_QAS=<subaccount-id-qas>
BTP_SUBACCOUNT_PROD=<subaccount-id-prod>
BTP_SUBACCOUNT_PLATFORM=<subaccount-id-platform>

# ── SAP Cloud Transport Management (CTMS) ────────────────────────────────────
CTMS_SERVICE_URL=https://transport-service.cfapps.<region>.hana.ondemand.com
CTMS_CLIENT_ID=<service-instance-client-id>
CTMS_CLIENT_SECRET=<service-instance-client-secret>
CTMS_TOKEN_URL=https://<btp-subaccount>.authentication.<region>.hana.ondemand.com/oauth/token

# Transport node IDs
CTMS_NODE_DEV=<node-id-dev>
CTMS_NODE_QAS=<node-id-qas>
CTMS_NODE_PROD=<node-id-prod>

# ── SAP Cloud ALM ─────────────────────────────────────────────────────────────
CALM_BASE_URL=https://<calm-tenant>.calm.sap.com
CALM_CLIENT_ID=<calm-client-id>
CALM_CLIENT_SECRET=<calm-client-secret>
CALM_TOKEN_URL=https://<calm-tenant>.authentication.<region>.hana.ondemand.com/oauth/token

# ── SAP Cloud Identity Services (CIS / IAS) ──────────────────────────────────
IAS_TENANT_URL=https://<tenant>.accounts.ondemand.com
IAS_CLIENT_ID=<ias-client-id>
IAS_CLIENT_SECRET=<ias-client-secret>

# ── SAP Alert Notification Service (ANS) ─────────────────────────────────────
ANS_SERVICE_URL=https://ans.cfapps.<region>.hana.ondemand.com
ANS_CLIENT_ID=<ans-client-id>
ANS_CLIENT_SECRET=<ans-client-secret>

# ── SAP Automation Pilot ──────────────────────────────────────────────────────
AUTOMATION_PILOT_URL=https://autopilot.cfapps.<region>.hana.ondemand.com
AUTOMATION_PILOT_CLIENT_ID=<client-id>
AUTOMATION_PILOT_CLIENT_SECRET=<client-secret>

# ── Security Scanning ─────────────────────────────────────────────────────────
SONAR_HOST_URL=https://sonarcloud.io
SONAR_TOKEN=<sonarcloud-token>
SONAR_ORGANIZATION=<sonar-org-key>

SNYK_TOKEN=<snyk-api-token>

# ── SIEM Integration ──────────────────────────────────────────────────────────
SIEM_ENDPOINT=https://<your-siem>/api/ingest
SIEM_API_KEY=<siem-api-key>

# ── Notification Channels ─────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/<your-webhook>
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<your-webhook>
NOTIFICATION_EMAIL=devops-alerts@<your-domain>
